  "custom": {
    "name": "自定义模型",
    "baseURL": "http://localhost:11434/v1",
    "apiPath": "/chat/completions",
    "defaultModel": "",
    "models": ["llama3", "llama3.1", "qwen2.5", "mistral", "gemma2", "phi3"],
    "authType": "bearer",
