[
  {
    "name": "身份证号码",
    "severity": "high",
    "pattern": "\\b[1-9]\\d{5}(?:18|19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]\\b",
    "showFirst": 6,
    "showLast": 4,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": "chineseId"
  },
  {
    "name": "手机号码",
    "severity": "high",
    "pattern": "\\b1[3-9]\\d{9}\\b",
    "showFirst": 3,
    "showLast": 4,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "银行卡号",
    "severity": "high",
    "pattern": "\\b\\d{16,19}\\b",
    "showFirst": 0,
    "showLast": 4,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": "luhn"
  },
  {
    "name": "邮箱地址",
    "severity": "medium",
    "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
    "emailMask": true,
    "fullMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "公网 IP 地址",
    "severity": "medium",
    "pattern": "\\b(?!(?:0|127|10|192\\.168|172\\.(?:1[6-9]|2\\d|3[01]))\\.)(?:(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\b",
    "showFirst": 1,
    "showLast": 1,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": "ipContext"
  },
  {
    "name": "内网 IP 地址",
    "severity": "medium",
    "pattern": "\\b(?:10\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)|172\\.(?:1[6-9]|2\\d|3[01])\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)|192\\.168\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.(?:25[0-5]|2[0-4]\\d|[01]?\\d\\d?))\\b",
    "showFirst": 1,
    "showLast": 1,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "API Key / Token",
    "severity": "high",
    "pattern": "\\b(?:sk|api|key|token|secret|auth|bearer)[-_][A-Za-z0-9]{16,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": true,
    "validatorType": null
  },
  {
    "name": "护照号码",
    "severity": "high",
    "pattern": "\\b[EeDdSsPpGgLl]\\d{7,8}\\b",
    "showFirst": 1,
    "showLast": 3,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "港澳通行证",
    "severity": "high",
    "pattern": "\\b[Cc]\\d{8}\\b",
    "showFirst": 1,
    "showLast": 3,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "统一社会信用代码",
    "severity": "medium",
    "pattern": "\\b[0-9A-HJ-NPQRTUWXY]{2}\\d{6}[0-9A-HJ-NPQRTUWXY]{10}\\b",
    "showFirst": 4,
    "showLast": 4,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "车牌号",
    "severity": "medium",
    "pattern": "\\b[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤川青藏琼宁][A-Z](?:[A-HJ-NP-Z0-9]{4,5}[A-HJ-NP-Z0-9挂学警港澳]|[DF][A-HJ-NP-Z0-9]{5})\\b",
    "showFirst": 2,
    "showLast": 1,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "营业执照编号",
    "severity": "medium",
    "pattern": "\\b\\d{15}\\b",
    "showFirst": 4,
    "showLast": 4,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "信用卡号",
    "severity": "high",
    "pattern": "\\b(?:4\\d{12}(?:\\d{3})?|5[1-5]\\d{14}|3[47]\\d{13}|6(?:011|5\\d{2})\\d{12}|(?:2131|1800|35\\d{3})\\d{11})\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "IBAN",
    "severity": "high",
    "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b",
    "showFirst": 4,
    "showLast": 4,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "出生日期",
    "severity": "medium",
    "pattern": "\\b(?:19|20)\\d{2}[-/.年](?:0[1-9]|1[0-2])[-/.月](?:0[1-9]|[12]\\d|3[01])[日号]?\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "GPS 坐标",
    "severity": "medium",
    "pattern": "\\b[-+]?\\d{1,3}\\.\\d{4,10}\\s*[,，]\\s*[-+]?\\d{1,3}\\.\\d{4,10}\\b",
    "showFirst": 3,
    "showLast": 3,
    "fullMask": false,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "OpenAI API Key",
    "severity": "high",
    "pattern": "\\bsk-(?:proj-|svcacct-)?[A-Za-z0-9-_]{20,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "AWS Access Key",
    "severity": "high",
    "pattern": "\\bAKIA[0-9A-Z]{16}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "阿里云 AccessKey",
    "severity": "high",
    "pattern": "\\bLTAI[a-zA-Z0-9]{12,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "腾讯云 SecretId",
    "severity": "high",
    "pattern": "\\bAKID[a-zA-Z0-9]{32,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "GitHub Token",
    "severity": "high",
    "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{20,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "GitLab Token",
    "severity": "high",
    "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "JWT Token",
    "severity": "high",
    "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "用户名密码",
    "severity": "high",
    "pattern": "\\b(?:password|passwd|pwd|secret)\\s*[=:：]\\s*\\S+|密码\\s*[=:：]\\s*\\S+|口令\\s*[=:：]\\s*\\S+",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": true,
    "validatorType": null
  },
  {
    "name": "数据库连接串",
    "severity": "high",
    "pattern": "\\b(?:jdbc|mongodb|redis|mysql|postgres(?:ql)?|mssql|oracle|sqlite)[+a-z]*://[^\\s]+",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": true,
    "validatorType": null
  },
  {
    "name": "SSH 私钥",
    "severity": "high",
    "pattern": "-----BEGIN\\s+(?:RSA|OPENSSH|EC|DSA|ED25519)\\s+PRIVATE\\s+KEY-----",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  },
  {
    "name": "通用私钥头",
    "severity": "high",
    "pattern": "-----BEGIN\\s+PRIVATE\\s+KEY-----",
    "fullMask": true,
    "emailMask": false,
    "caseInsensitive": false,
    "validatorType": null
  }
]
